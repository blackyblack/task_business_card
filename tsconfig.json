{
    "compilerOptions": {
        "target": "ES2023",
        "module": "Node16",
        "moduleResolution": "Node16",
        "rootDir": ".",
        "outDir": "dist",
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true
    },
    "include": ["src/**/*.ts", "prisma/**/*.ts", "prisma.config.ts"]
}
